local function runScript(url, name)
    notify("RAILhub", "Launching script " .. name)
    
    pcall(function()
        -- Ensure the authorization flag is passed to the loaded script
        _G.RAILhub_KeyAuthorized = true
        loadstring(game:HttpGet(url))()
    end)
end

