local random = Random.new(tick() * 1000 + math.random(1, 999999))

local function safeWait(min, max)
    task.wait(random:NextNumber() * (max - min) + min)
end

local function randomStr(len)
    local chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz123456789"
    local result = {}
    for i = 1, len or 10 do
        local pos = random:NextInteger(1, #chars)
        table.insert(result, chars:sub(pos, pos))
    end
    return table.concat(result)
end

local encKey = random:NextInteger(100, 999)

local function encrypt(str)
    local result = {}
    local salt = random:NextInteger(100, 999)
    table.insert(result, salt)
    
    for i = 1, #str do
        local byte = string.byte(str, i)
        table.insert(result, bit32.bxor(byte, (salt + i + encKey) % 256))
    end
    
    return result
end

local function decrypt(arr)
    if type(arr) ~= "table" or #arr == 0 then return "" end
    
    local salt = arr[1]
    local result = {}
    
    for i = 2, #arr do
        local byte = bit32.bxor(arr[i], (salt + (i - 1) + encKey) % 256)
        table.insert(result, string.char(byte))
    end
    
    return table.concat(result)
end

local SafeFunc = {}

SafeFunc.httpGet = function(url)
    local methods = {
        function() return game:HttpGet(url) end,
        function() return game:HttpGetAsync(url) end,
        function() 
            if request then
                return request({Url = url, Method = "GET"}).Body 
            end
        end,
    }
    
    for _, method in ipairs(methods) do
        safeWait(0.01, 0.03)
        local ok, result = pcall(method)
        if ok and result then return result end
    end
    return nil
end

SafeFunc.loadstring = function(code)
    if not code or type(code) ~= "string" or #code == 0 then
        return nil
    end
    
    safeWait(0.02, 0.05)
    
    local ok, func = pcall(loadstring, code)
    if ok and type(func) == "function" then
        return func
    end
    
    return nil
end

